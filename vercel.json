{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{c/*.html,data/channels.json}"
    }
  },
  "rewrites": [
    {
      "source": "/u/:name",
      "destination": "/studio"
    },
    {
      "source": "/c/:slug/claim",
      "destination": "/api/cpage?slug=:slug&page=claim"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/cpage?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/c/(channel|claim)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(studio|u/:name)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/.well-known/bwalletx-theme.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.bvideox.com"
        }
      ],
      "destination": "https://bvideox.com/",
      "permanent": true
    },
    {
      "source": "/flick-off",
      "destination": "https://bmintx.com/flick-off/youtube",
      "permanent": false
    },
    {
      "source": "/flick-off/:path*",
      "destination": "https://bmintx.com/flick-off/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bvideox.com"
        }
      ],
      "destination": "https://bvideox.com/:path*",
      "permanent": true
    }
  ]
}
