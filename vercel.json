{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/flick-off",
      "destination": "https://bmintx.com/flick-off/youtube",
      "permanent": false
    },
    {
      "source": "/flick-off/:path*",
      "destination": "https://bmintx.com/flick-off/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bvideox.com"
        }
      ],
      "destination": "https://bvideox.com/:path*",
      "permanent": true
    }
  ]
}